meta {
  name: Swagger UI
  type: http
  seq: 9
}

get {
  url: {{objectStorageBaseUrl}}/api/docs/
  body: none
  auth: inherit
}

tests {
  test("Serves authenticated documentation", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("text/html");
  });
}

docs {
  The trailing slash avoids the redirect. Browser navigation and documentation assets also require Authorization.
}
