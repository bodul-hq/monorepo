meta {
  name: Run outbox
  type: http
  seq: 9
}

post {
  url: {{offersBaseUrl}}/api/outbox/run
  body: json
  auth: none
}

body:json {
  { "limit": 2 }
}

docs {
  Delivers one batch to customer-facing's /api/inbox when offers runs with
  CUSTOMER_FACING_URL; without it, returns 503 and rows remain untouched.
  The limit must be an integer from 1 through 1000; invalid requests return 400.
  A 202 from customer-facing means stored only: run its inbox, commands and
  events afterwards.
}
