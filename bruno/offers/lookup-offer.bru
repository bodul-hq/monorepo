meta {
  name: Look up offer
  type: http
  seq: 9
}

get {
  url: {{offersBaseUrl}}/api/offers?retailer_code={{retailerCode}}&url={{offerUrl}}
  body: none
  auth: none
}

params:query {
  retailer_code: {{retailerCode}}
  url: {{offerUrl}}
}

docs {
  Looks up the exact retailer and URL identity. Returns 404 until the offer has been projected.
}
