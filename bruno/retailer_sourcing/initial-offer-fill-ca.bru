meta {
  name: Start Anker CA English initial offer fill
  type: http
  seq: 13
}

post {
  url: {{retailerSourcingBaseUrl}}/api/initial-offer-fills
  body: json
  auth: none
}

body:json {
  { "retailers": ["ankerca"] }
}

docs {
  Queues an English-only Anker CA initial fill (CA/EN, CAD) and returns its retailer
  and run_id in fills. Commands run through the existing workers or POST /api/commands/run.
  Run POST /api/events/run to advance reactions: token acquisition, batches of up
  to 500 product IDs, then one complete GraphQL fetch per product.
  OfferDetailsFetched is terminal. French is deferred.
}
