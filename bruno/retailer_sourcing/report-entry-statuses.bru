meta {
  name: Report queue entry statuses
  type: http
  seq: 8
}

get {
  url: {{retailerSourcingBaseUrl}}/api/reporting/entry-statuses
  body: none
  auth: bearer
}

auth:bearer {
  token: 8bcb74f24405708e90b0aa1be5679f422ea2ba199ae8ab0d0f1e80acd8c9c97d
}

docs {
  Reports inbox_entries, command_entries, event_entries and outbox_entries arrays.
  Each array groups exact counts by current status, with numeric status and status_text.
  Counts include entries scheduled in [window_start, window_end): the inclusive
  UTC midnight start and exclusive next UTC midnight end of the current UTC day.
  Empty arrays mean no entries in that queue are scheduled within this window.
  This read-only request does not process queues.
  Requires a configured database.

}
