meta {
  name: Search offers
  type: http
  seq: 12
}

get {
  url: {{customerFacingBaseUrl}}/api/offers/search?q=charger&limit=30&offset=0
  body: none
  auth: none
}

params:query {
  q: charger
  limit: 30
  offset: 0
}

docs {
  Returns items, limit, offset and has_more. Exact title, word similarity, then created_at and id descending.
  Limit is 1–100; offset is 0–2147483647. Defaults are 30 and 0.
  Price amount is a decimal string of signed i64 minor units.
  Each offer includes ordered images; old offers return an empty array.
  Reads never run queues. Process inbox and commands before expecting new offers.
}
