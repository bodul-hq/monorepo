# Copy to .env (`make .env`) for local development. The Makefile and the Diesel
# CLI read it; a DATABASE_URL set in your shell takes precedence.
#
# Points at the retailer_sourcing-db container from the workspace's
# compose-infra.yaml, with the credentials from its .env.example. The container
# publishes no port, so this uses its fixed address on the `bodul` network.
DATABASE_URL=postgres://retailer_sourcing:retailer_sourcing@172.28.100.10:5432/retailer_sourcing_dev
