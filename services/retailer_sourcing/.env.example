# Copy to .env (`make .env`) for local development. The Makefile reads it;
# settings in your shell take precedence in Makefile targets.
#
# Points at the retailer_sourcing-db container from the workspace's
# compose-infra.yaml, with the credentials from its .env.example. The container
# publishes no port, so this uses its fixed address on the `bodul` network.
DATABASE_URL=postgres://retailer_sourcing:retailer_sourcing@172.28.100.10:5432/retailer_sourcing_dev

# Optional PostgreSQL tests; the role must be allowed to create/drop schemas.
# DATABASE_URL_TEST=postgres://object_storing:object_storing@172.28.100.31:5432/object_storing_test

# Required with DATABASE_URL. The service uses REST for pipeline artifacts.
OBJECT_STORAGE_URL=http://172.28.100.43:3000
# Public development credential, shared with object_storage.
OBJECT_STORAGE_TOKEN=6fe0382d64bba74e205af86e397d902c0f5e6f3d8e15b1a4f87c6a309d752eb1
