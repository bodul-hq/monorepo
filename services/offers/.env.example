# Required for startup. Empty values fail startup.
# DATABASE_URL=postgres://offers:replace_me@127.0.0.1:5432/offers_dev

# Required only for make test-postgres. Must allow CREATE/DROP SCHEMA.
# DATABASE_URL_TEST=postgres://offers:replace_me@127.0.0.1:5432/offers_test

# Default: 3000. Set in the shell or on make's command line.
# PORT=3001

# Reporting API bearer token. Match the development dashboard's OFFERS_TOKEN.
# OFFERS_REPORTING_TOKEN=offers-development-token

# Optional HTTP outbox delivery to customer-facing's /api/inbox: an HTTP(S)
# origin without credentials, path, query or fragment. Unset means
# /api/outbox/run returns 503; an empty or invalid value fails startup.
# CUSTOMER_FACING_URL=http://127.0.0.1:3003

# AMQP_URL and OUTBOX_EXCHANGE are no longer read: offers does not publish to
# RabbitMQ, and they never act as a fallback.
