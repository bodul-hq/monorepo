# Required at startup. Use this service's own development database.
# DATABASE_URL=postgres://customer_facing:replace_me@127.0.0.1:5432/customer_facing_dev

# Required only for make test-postgres; must allow CREATE/DROP SCHEMA.
# DATABASE_URL_TEST=postgres://customer_facing:replace_me@127.0.0.1:5432/customer_facing_test

# Default is 3000. Shell and make command-line values override .env.
# PORT=3003

# Read-only reporting bearer token. An explicit empty value authorizes no requests.
# CUSTOMER_FACING_REPORTING_TOKEN=customer-facing-development-token
